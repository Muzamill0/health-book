# Copy this file to .env and fill in your values.

# Website URL (no trailing slash)
APP_URL=https://your-domain.com

# MySQL database
DB_HOST=localhost
DB_PORT=3306
# MAMP only: /Applications/MAMP/tmp/mysql/mysql.sock — leave empty on a normal server
DB_SOCKET=
DB_NAME=health_book
DB_USER=your_db_user
DB_PASS=your_db_password

# Old Stripe keys — no longer used (payments now go through Paddle)
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Paddle Billing — https://vendors.paddle.com (sandbox: https://sandbox-vendors.paddle.com)
# PADDLE_ENV: sandbox while testing, production when live
PADDLE_ENV=sandbox
# Developer tools → Authentication → API keys (server-side, keep secret)
PADDLE_API_KEY=
# Developer tools → Authentication → Client-side tokens (starts with test_ or live_)
PADDLE_CLIENT_TOKEN=
# Developer tools → Notifications → your webhook destination → secret key
PADDLE_WEBHOOK_SECRET=
# Tax category for the products: standard (default) or another category approved on your Paddle account
PADDLE_TAX_CATEGORY=standard
